# /etc/career-platform/env on the EC2 instance (owner root, group career, mode 640). Real values never go in Git.
# sslmode=verify-full checks the RDS certificate and hostname; RDS PostgreSQL 15+ refuses non-TLS connections anyway.
DATABASE_URL=postgresql+psycopg://career_app:<password>@<rds-endpoint>:5432/career?sslmode=verify-full&sslrootcert=/etc/ssl/rds/global-bundle.pem
